OPENAI_API_KEY=
# Optional override for Turning Test's lightweight OpenAI model.
TURNING_TEST_OPENAI_MODEL=gpt-4o-mini

# Required for Turning Test evaluation. Use a model ID explicitly granted to your
# account (prefer Pangram 4 when available); do not switch it between comparisons.
PANGRAM_API_KEY=
PANGRAM_MODEL=pangram-v4
PANGRAM_API_BASE_URL=https://text.api.pangram.com/v1
TURNING_TEST_EVALUATION_MIN_WORDS=50
